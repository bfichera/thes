class Thes < Formula
  desc "Lightning-fast offline terminal thesaurus with vim keys"
  homepage "https://github.com/bfichera/thes"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/bfichera/thes/releases/download/v@VERSION@/thes-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_MAC_ARM@"
    end
    on_intel do
      url "https://github.com/bfichera/thes/releases/download/v@VERSION@/thes-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_MAC_INTEL@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/bfichera/thes/releases/download/v@VERSION@/thes-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_ARM@"
    end
    on_intel do
      url "https://github.com/bfichera/thes/releases/download/v@VERSION@/thes-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_INTEL@"
    end
  end

  def install
    bin.install "thes"
    man1.install "thes.1"
    bash_completion.install "completions/thes.bash" => "thes"
    zsh_completion.install "completions/_thes"
    fish_completion.install "completions/thes.fish"
  end

  test do
    assert_match "happy", shell_output("#{bin}/thes -p glad")
  end
end
