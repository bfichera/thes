# Maintainer: Bryan Fichera <bfichera@anl.gov>
pkgname=thes-tui-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Lightning-fast offline terminal thesaurus with vim keys"
arch=('x86_64' 'aarch64')
url="https://github.com/bfichera/thes"
license=('MIT')
provides=('thes')
conflicts=('thes' 'thes-bin')
source_x86_64=("thes-tui-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/thes-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("thes-tui-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/thes-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('@SHA_LINUX_INTEL@')
sha256sums_aarch64=('@SHA_LINUX_ARM@')

package() {
  cd "thes-$CARCH-unknown-linux-musl"
  install -Dm755 thes "$pkgdir/usr/bin/thes"
  install -Dm644 thes.1 "$pkgdir/usr/share/man/man1/thes.1"
  install -Dm644 completions/thes.bash "$pkgdir/usr/share/bash-completion/completions/thes"
  install -Dm644 completions/_thes "$pkgdir/usr/share/zsh/site-functions/_thes"
  install -Dm644 completions/thes.fish "$pkgdir/usr/share/fish/vendor_completions.d/thes.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-WORDNET "$pkgdir/usr/share/licenses/$pkgname/LICENSE-WORDNET"
}
